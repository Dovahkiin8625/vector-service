# 服务
VS_HOST=0.0.0.0
VS_PORT=8080
VS_WORKERS=1
VS_LOG_LEVEL=INFO
VS_LOG_FORMAT=json
VS_DEBUG=false

# 嵌入
VS_EMBEDDING_BACKEND=bge-m3
VS_EMBEDDING_MODEL_DIR=./models/bge-m3
VS_EMBEDDING_AUTO_DOWNLOAD=true
# Eager-load on startup (default false). Set to true for legacy
# behaviour where the embedder is constructed + loaded during
# lifespan so /readyz reports embedder=loaded at boot. When false,
# operators must trigger loading via POST /v1/models/{id}/load
# (e.g. from the dashboard's "加载/卸载" tab).
VS_EMBEDDING_AUTO_LOAD=false
VS_EMBEDDING_DEVICE=auto
VS_EMBEDDING_BATCH_SIZE=32
VS_EMBEDDING_MAX_LENGTH=512
VS_EMBEDDING_MAX_TEXTS_PER_REQUEST=256
VS_EMBEDDING_MAX_CHARS_PER_TEXT=8192
VS_EMBEDDING_HF_REPO=BAAI/bge-m3
VS_EMBEDDING_ONNX_REPO=BAAI/bge-m3-onnx
VS_EMBEDDING_MS_REPO=BAAI/bge-m3
# huggingface | modelscope
VS_EMBEDDING_DOWNLOAD_SOURCE=modelscope

# 向量库：直连 Milvus server（standalone 或 cluster）。
# service 用 pymilvus 直接连；Milvus ≥ 2.4 推荐，能开 native database 隔离。
VS_VECTOR_STORE_BACKEND=milvus
VS_MILVUS_URI=http://localhost:19530
# 三选一填一个就行（按优先级）：token > (user+password) > 空
VS_MILVUS_USER=
VS_MILVUS_PASSWORD=
VS_MILVUS_TOKEN=
VS_MILVUS_TIMEOUT=30

# 运行时
VS_DATA_DIR=./data

# ---- Reranker ----
# Required: backend name registered in RERANKER_REGISTRY.
VS_RERANKER__BACKEND=bge-reranker-v2-m3
# Eager-load on startup (default false).
VS_RERANKER__AUTO_LOAD=false
VS_RERANKER__MODEL_DIR=./models/bge-reranker-v2-m3
VS_RERANKER__DEVICE=auto
VS_RERANKER__BATCH_SIZE=32
VS_RERANKER__MAX_DOCUMENTS_PER_REQUEST=256
VS_RERANKER__MAX_QUERY_CHARS=2048
VS_RERANKER__MAX_CHARS_PER_DOC=8192
VS_RERANKER__MAX_LENGTH=512
VS_RERANKER__TOP_N_DEFAULT=10
VS_RERANKER__MAX_TOP_N=64
VS_RERANKER__DOWNLOAD_SOURCE=modelscope
VS_RERANKER__MODEL_NAME=BAAI/bge-reranker-v2-m3
VS_RERANKER__HF_REPO=BAAI/bge-reranker-v2-m3
VS_RERANKER__MS_REPO=BAAI/bge-reranker-v2-m3

# ---------- Image embedding (env prefix VS_IMAGE_EMBEDDING__) ----------
# OpenCLIP weights are fetched by open_clip itself from its own CDN — no
# HF repo lookup. Set OPEN_CLIP_DOWNLOAD_PATH (or MODEL_DIR below) to
# control the local cache.
VS_IMAGE_EMBEDDING__BACKEND=openclip-vit-l-14
VS_IMAGE_EMBEDDING__MODEL_DIR=./models/openclip-vit-l-14
VS_IMAGE_EMBEDDING__AUTO_DOWNLOAD=true
# Eager-load on startup (default false).
VS_IMAGE_EMBEDDING__AUTO_LOAD=false
VS_IMAGE_EMBEDDING__DEVICE=auto
VS_IMAGE_EMBEDDING__BATCH_SIZE=16
VS_IMAGE_EMBEDDING__MAX_IMAGES_PER_REQUEST=64
VS_IMAGE_EMBEDDING__MAX_IMAGE_BYTES=10485760
# Comma-separated MIME allow-list (defaults to image/jpeg,image/png,image/webp)
VS_IMAGE_EMBEDDING__ALLOWED_MIME=image/jpeg,image/png,image/webp

# ---------- Multimodal embedding (env prefix VS_MULTIMODAL_EMBEDDING__) ----------
# Cross-modal text + image embedder (Chinese-CLIP). Vectors from both
# towers land in a shared 512d projection space, so cosine similarity
# works across modalities (text-search-image, image-search-text).
# Weights are pulled from HuggingFace (HF_REPO) into MODEL_DIR.
VS_MULTIMODAL_EMBEDDING__BACKEND=chinese-clip-vit-base-patch16
VS_MULTIMODAL_EMBEDDING__MODEL_DIR=./models/chinese-clip-vit-base-patch16
VS_MULTIMODAL_EMBEDDING__AUTO_DOWNLOAD=true
# Eager-load on startup (default false).
VS_MULTIMODAL_EMBEDDING__AUTO_LOAD=false
VS_MULTIMODAL_EMBEDDING__DEVICE=auto
VS_MULTIMODAL_EMBEDDING__BATCH_SIZE=16
VS_MULTIMODAL_EMBEDDING__MAX_ITEMS_PER_REQUEST=64
VS_MULTIMODAL_EMBEDDING__MAX_TEXT_CHARS=512
VS_MULTIMODAL_EMBEDDING__MAX_IMAGE_BYTES=10485760
VS_MULTIMODAL_EMBEDDING__HF_REPO=OFA-Sys/chinese-clip-vit-base-patch16
VS_MULTIMODAL_EMBEDDING__ALLOWED_MIME=image/jpeg,image/png,image/webp
# ---- Document Parser (Docling) ----
# Used by POST /v1/parse, /v1/parse/stream and /v1/ingest. Lazy-loaded
# by default; set AUTO_LOAD=true to warm the DocumentConverter at boot
# (recommended when uploads are interactive — a cold converter costs
# ~10-30s of model loading on the first PDF).
VS_PARSER__AUTO_LOAD=false
VS_PARSER__MAX_FILE_SIZE_MB=100
# Device for Docling layout / TableFormer / RapidOCR / VLM models:
# auto (CUDA when available) | cpu | cuda
VS_PARSER__DEVICE=auto
# Extract document pictures to disk and reference them from the
# markdown via /artifacts/<doc-id>/images/... (static mount in main.py).
VS_PARSER__SAVE_IMAGES=true
VS_PARSER__ARTIFACTS_DIR=./data/artifacts
VS_PARSER__ARTIFACTS_URL_PREFIX=/artifacts
# RapidOCR (PP-OCRv4) language packs; "ch" = Chinese+English. Selective
# OCR runs on scanned pages/regions only — digital PDF pages skip OCR.
VS_PARSER__OCR_LANGS=["ch"]
# Crop/OCR resolution scale for extracted images (higher = sharper,
# more VRAM/disk).
VS_PARSER__IMAGES_SCALE=2.0
# Vision-model profile (profile=vlm requests only; weights are NOT
# downloaded for the default standard profile).
VS_PARSER__VLM_PRESET=granite_docling
# Docling downloads its layout models from the HuggingFace Hub. On
# hosts where huggingface.co is unreachable, point it at a mirror:
#VS_PARSER__HF_ENDPOINT=https://hf-mirror.com

# ---- Chunking ----
# Default strategy used when /v1/chunk or /v1/ingest omit the field:
# fixed | paragraph | recursive | semantic | llm
VS_CHUNKING__STRATEGY=recursive
# Defaults applied when requests omit chunk_size/chunk_overlap.
VS_CHUNKING__CHUNK_SIZE=500
VS_CHUNKING__CHUNK_OVERLAP=75

# ---- LLM (external OpenAI-compatible chat backend) ----
# Powers strategy=llm and add_context=true (contextual retrieval).
# The service does not serve chat; point this at any /chat/completions
# endpoint (OpenAI, vLLM, LM Studio, ...). Left empty => query-rewrite
# features of /v1/retrieval (HyDE / Multi-Query / Step-Back / Decomposition)
# and LLM chunking are disabled; dense retrieval keeps working.
VS_LLM__BASE_URL=
VS_LLM__API_KEY=
VS_LLM__MODEL=
VS_LLM__TIMEOUT_SECONDS=60
VS_LLM__MAX_CONCURRENCY=4
